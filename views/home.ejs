<!doctype html>
<html lang="en">
  <head>
    <%- include('./partials/head') %>
  </head>
  <body class="bg-page min-h-screen font-body">

    <%- include('./components/header') %>

    <!-- Ambient glow -->
    <div class="fixed inset-0 pointer-events-none -z-10"
         style="background:
           radial-gradient(ellipse 55% 35% at 50% 0%, rgba(124,58,237,0.10) 0%, transparent 70%),
           radial-gradient(ellipse 35% 25% at 90% 90%, rgba(168,85,247,0.05) 0%, transparent 60%);"
         aria-hidden="true">
    </div>

    <main class="max-w-6xl mx-auto px-6 py-12">

      <!-- Page Header -->
      <div class="flex items-end justify-between mb-10">
        <div>
          <p class="text-xs font-medium text-violet-400 tracking-widest uppercase mb-2">
            Latest Posts
          </p>
          <h1 class="text-3xl font-display font-bold text-zinc-100 tracking-tight">
            All Blogs
          </h1>
          <p class="mt-1.5 text-sm text-zinc-500">
            <%= blogs.length %> post<%= blogs.length !== 1 ? 's' : '' %> published
          </p>
        </div>

        
      </div>

      <!-- No blogs state -->
      <% if (blogs.length === 0) { %>
        <div class="flex flex-col items-center justify-center py-24 text-center">
          <div class="w-14 h-14 rounded-2xl bg-violet-500/10 border border-violet-500/20
                      flex items-center justify-center mb-4">
            <svg class="w-6 h-6 text-violet-400" viewBox="0 0 24 24" fill="none"
                 stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 20h9"/>
              <path d="M16.5 3.5a2.121 2.121 0 0 1 3 3L7 19l-4 1 1-4L16.5 3.5z"/>
            </svg>
          </div>
          <h2 class="text-lg font-display font-bold text-zinc-300">No blogs yet</h2>
          <p class="text-sm text-zinc-600 mt-1 mb-6">Be the first one to publish something.</p>
          <a href="/add-blog"
             class="flex items-center gap-2 px-5 py-2.5 rounded-xl bg-violet-600
                    hover:bg-violet-500 text-sm font-semibold text-white transition-all duration-200">
            Write your first blog
          </a>
        </div>

      <% } else { %>

        <!-- Blog Grid -->
        <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-6">
          <% blogs.forEach(blog => { %>

            <a href="/blog/<%= blog._id %>"
               class="group flex flex-col bg-[#16161F] rounded-2xl border border-white/[0.07]
                      hover:border-violet-500/30 overflow-hidden
                      shadow-[0_8px_32px_rgba(0,0,0,0.3)]
                      hover:shadow-[0_8px_40px_rgba(124,58,237,0.12)]
                      transition-all duration-250">

              <!-- Cover Image -->
              <% if (blog.coverImageURL) { %>
                <div class="w-full h-44 overflow-hidden bg-zinc-900 shrink-0">
                  <img src="<%= blog.coverImageURL %>"
                       alt="<%= blog.title %>"
                       class="w-full h-full object-cover opacity-90
                              group-hover:opacity-100 group-hover:scale-105
                              transition-all duration-500" />
                </div>
              <% } else { %>
                <!-- Placeholder when no cover image -->
                <div class="w-full h-44 bg-gradient-to-br from-violet-500/10 to-purple-900/20
                            flex items-center justify-center shrink-0 border-b border-white/[0.05]">
                  <svg class="w-8 h-8 text-violet-500/40" viewBox="0 0 24 24" fill="none"
                       stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="3" width="18" height="18" rx="2"/>
                    <path d="m3 9 4-4 4 4 4-4 4 4"/>
                    <path d="m3 15 4 4 4-4 4 4 4-4"/>
                  </svg>
                </div>
              <% } %>

              <!-- Card Body -->
              <div class="flex flex-col flex-1 p-5">

                <!-- Title -->
                <h2 class="text-base font-display font-bold text-zinc-100
                           group-hover:text-violet-300 transition-colors duration-200
                           line-clamp-2 leading-snug mb-2">
                  <%= blog.title %>
                </h2>

                <!-- Excerpt -->
                <p class="text-sm text-zinc-500 leading-relaxed line-clamp-3 flex-1">
                  <%= blog.body.substring(0, 120) %>...
                </p>

                <!-- Footer -->
                <div class="flex items-center justify-between mt-4 pt-4
                            border-t border-white/[0.05]">
                  <span class="text-xs text-zinc-600">
                    <%= new Date(blog.createdAt).toLocaleDateString('en-US', {
                          month: 'short', day: 'numeric', year: 'numeric'
                        }) %>
                  </span>
                  <span class="inline-flex items-center gap-1 text-xs font-medium
                               text-violet-400 group-hover:text-violet-300 transition-colors">
                    Read more
                    <svg class="w-3 h-3 group-hover:translate-x-0.5 transition-transform duration-200"
                         viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M5 12h14M12 5l7 7-7 7"/>
                    </svg>
                  </span>
                </div>

              </div>
            </a>

          <% }) %>
        </div>

      <% } %>
    </main>

  </body>
</html>