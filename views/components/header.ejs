<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>P-Blogs</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              page: "#0B0B0F",
              surface: "#12121A",
              card: "#16161F",
            },
            fontFamily: {
              display: ["Syne", "sans-serif"],
              body: ["Outfit", "sans-serif"],
            },
            boxShadow: {
              menu: "0 16px 48px rgba(0,0,0,0.6), 0 0 0 1px rgba(124,58,237,0.12)",
              cta: "0 0 22px rgba(124,58,237,0.45)",
            },
          },
        },
      };
    </script>
    <style>
      body { font-family: "Outfit", sans-serif; }

      .header-line::before {
        content: "";
        display: block;
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent 0%, #7c3aed 25%, #a855f7 50%, #7c3aed 75%, transparent 100%
        );
      }

      .cursor-blink {
        display: inline-block;
        width: 2px;
        height: 18px;
        background: #a855f7;
        margin-left: 3px;
        vertical-align: middle;
        border-radius: 1px;
        animation: blink 1.1s step-start infinite;
      }
      @keyframes blink {
        0%, 100% { opacity: 1; }
        50% { opacity: 0; }
      }

      .dropdown-menu {
        transform: translateY(-6px) scale(0.97);
        opacity: 0;
        pointer-events: none;
        transition:
          transform 0.18s cubic-bezier(0.4, 0, 0.2, 1),
          opacity 0.18s cubic-bezier(0.4, 0, 0.2, 1);
        transform-origin: top right;
      }
      .dropdown-menu.open {
        transform: translateY(0) scale(1);
        opacity: 1;
        pointer-events: auto;
      }

      .chevron { transition: transform 0.22s cubic-bezier(0.4, 0, 0.2, 1); }
      .chevron.open { transform: rotate(180deg); }

      .cta-btn { position: relative; overflow: hidden; }
      .cta-btn::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(105deg, transparent 40%, rgba(255,255,255,0.1) 50%, transparent 60%);
        transform: translateX(-100%);
        transition: transform 0.4s ease;
      }
      .cta-btn:hover::after { transform: translateX(100%); }

      .mobile-drawer {
        max-height: 0;
        overflow: hidden;
        transition: max-height 0.3s cubic-bezier(0.4, 0, 0.2, 1);
      }
      .mobile-drawer.open { max-height: 400px; }
    </style>
  </head>

  <body class="bg-page min-h-screen">

    <header class="header-line sticky top-0 z-50 bg-surface/80 backdrop-blur-xl border-b border-white/[0.05]">
      <nav class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between gap-4">

        <!-- LOGO -->
        <a href="/" class="flex items-center gap-2.5 group shrink-0" aria-label="P-Blogs home">
          <span class="font-display font-bold text-lg leading-none text-zinc-100 tracking-tight">
            P<span class="text-violet-400">-</span>Blogs
          </span>
          <span class="cursor-blink" aria-hidden="true"></span>
        </a>

        <!-- DESKTOP NAV -->
        <div class="hidden md:flex items-center gap-1">

          <a href="/"
             class="flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-medium
                    text-zinc-400 hover:text-zinc-100 hover:bg-white/[0.05] transition-colors duration-150">
            <svg class="w-4 h-4 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                 stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5Z"/>
              <path d="M9 21V12h6v9"/>
            </svg>
            Home
          </a>

          <% if (locals.user) { %>
            <a href="/blog/addblog"
               class="cta-btn flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold
                      bg-violet-600 hover:bg-violet-500 text-white shadow-cta
                      hover:shadow-[0_0_28px_rgba(124,58,237,0.6)] transition-all duration-200 ml-1">
              <svg class="w-3.5 h-3.5 shrink-0" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              Add Blog
            </a>
          <% } %>

          <span class="w-1 h-1 rounded-full bg-zinc-700 mx-3 shrink-0" aria-hidden="true"></span>

          <% if (locals.user) { %>
            <div class="relative" id="userDropdown">
              <button
                id="dropdownBtn"
                onclick="toggleDropdown()"
                aria-haspopup="true"
                aria-expanded="false"
                class="flex items-center gap-2.5 pl-1.5 pr-3 py-1.5 rounded-full
                       border border-zinc-700/60 hover:border-violet-500/50
                       bg-white/[0.03] hover:bg-violet-500/[0.07]
                       text-zinc-200 text-sm font-medium transition-all duration-200 cursor-pointer">
                <div class="w-7 h-7 rounded-full bg-violet-950 border border-violet-500/40
                            flex items-center justify-center shrink-0">
                  <span class="text-[10px] font-bold text-violet-300 tracking-wide">
                    <%= locals.user.fullName ? locals.user.fullName[0].toUpperCase() : 'G' %>
                  </span>
                </div>
                <span class="text-zinc-300"><%= locals.user.fullName %></span>
                <svg id="chevronIcon" class="chevron w-3.5 h-3.5 text-zinc-500 shrink-0"
                     viewBox="0 0 24 24" fill="none" stroke="currentColor"
                     stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M6 9l6 6 6-6"/>
                </svg>
              </button>

              <div id="dropdownMenu"
                   class="dropdown-menu absolute top-[calc(100%+10px)] right-0 w-56
                          bg-card border border-white/[0.07] rounded-2xl shadow-menu overflow-hidden"
                   role="menu" aria-labelledby="dropdownBtn">

                <!-- User info -->
                <div class="px-4 py-3 border-b border-white/[0.06]">
                  <div class="flex items-center gap-2.5">
                    <div class="w-8 h-8 rounded-full bg-violet-950 border border-violet-500/40
                                flex items-center justify-center shrink-0">
                      <span class="text-xs font-bold text-violet-300">
                        <%= locals.user.fullName ? locals.user.fullName[0].toUpperCase() : 'G' %>
                      </span>
                    </div>
                    <div class="min-w-0">
                      <p class="text-sm font-semibold text-zinc-100 truncate">
                        <%= locals.user.fullName %>
                      </p>
                      <p class="text-xs text-zinc-500 truncate">
                        <%= locals.user.email %>
                      </p>
                    </div>
                  </div>
                </div>

                <div class="p-1.5">
                  <a href="/user/signout" role="menuitem"
                     class="flex items-center gap-3 px-3 py-2.5 rounded-xl text-sm font-medium
                            text-red-400/80 hover:text-red-400 hover:bg-red-500/10
                            transition-colors duration-150">
                    <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                         stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                      <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                      <polyline points="16 17 21 12 16 7"/>
                      <line x1="21" y1="12" x2="9" y2="12"/>
                    </svg>
                    Sign Out
                  </a>
                </div>
              </div>
            </div>

          <% } else { %>
            <a href="/user/signin"
               class="px-4 py-2 rounded-lg text-sm font-medium text-zinc-400
                      hover:text-zinc-100 hover:bg-white/[0.05] transition-colors duration-150">
              Sign In
            </a>
            <a href="/user/signup"
               class="cta-btn flex items-center gap-2 px-4 py-2 rounded-lg text-sm font-semibold
                      bg-violet-600 hover:bg-violet-500 text-white shadow-cta
                      transition-all duration-200 ml-1">
              Sign Up
            </a>
          <% } %>
        </div>

        <!-- MOBILE HAMBURGER -->
        <button id="hamburger" onclick="toggleMobile()" aria-label="Open menu" aria-expanded="false"
                class="md:hidden flex flex-col gap-[5px] p-2 rounded-lg
                       hover:bg-white/[0.05] transition-colors duration-150">
          <span class="block w-5 h-[1.5px] bg-zinc-400 rounded-full" id="bar1"></span>
          <span class="block w-5 h-[1.5px] bg-zinc-400 rounded-full" id="bar2"></span>
          <span class="block w-3.5 h-[1.5px] bg-zinc-400 rounded-full" id="bar3"></span>
        </button>
      </nav>

      <!-- MOBILE DRAWER -->
      <div id="mobileDrawer" class="mobile-drawer md:hidden border-t border-white/[0.05]">
        <div class="flex flex-col gap-0.5 p-3">

          <% if (locals.user) { %>

            <!-- ✅ USER INFO CARD IN MOBILE -->
            <div class="flex items-center gap-3 px-4 py-3 mb-1
                        bg-violet-500/[0.05] border border-violet-500/[0.1] rounded-xl">
              <div class="w-9 h-9 rounded-full bg-violet-950 border border-violet-500/40
                          flex items-center justify-center shrink-0">
                <span class="text-sm font-bold text-violet-300">
                  <%= locals.user.fullName ? locals.user.fullName[0].toUpperCase() : 'G' %>
                </span>
              </div>
              <div class="min-w-0">
                <p class="text-sm font-semibold text-zinc-100 truncate">
                  <%= locals.user.fullName %>
                </p>
                <p class="text-xs text-zinc-500 truncate">
                  <%= locals.user.email %>
                </p>
              </div>
            </div>

            <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium
                               text-zinc-400 hover:text-zinc-100 hover:bg-white/[0.05] transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5Z"/>
                <path d="M9 21V12h6v9"/>
              </svg>
              Home
            </a>

            <a href="/blog/addblog"
               class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium
                      text-violet-400 hover:text-violet-300 hover:bg-violet-500/10 transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                <path d="M12 5v14M5 12h14"/>
              </svg>
              Add Blog
            </a>

            <div class="h-px bg-white/[0.05] my-1"></div>

            <a href="/user/signout"
               class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium
                      text-red-400/70 hover:text-red-400 hover:bg-red-500/10 transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
                <polyline points="16 17 21 12 16 7"/>
                <line x1="21" y1="12" x2="9" y2="12"/>
              </svg>
              Sign Out
            </a>

          <% } else { %>

            <a href="/" class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium
                               text-zinc-400 hover:text-zinc-100 hover:bg-white/[0.05] transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M3 9.5L12 3l9 6.5V20a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V9.5Z"/>
                <path d="M9 21V12h6v9"/>
              </svg>
              Home
            </a>

            <div class="h-px bg-white/[0.05] my-1"></div>

            <a href="/user/signin"
               class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium
                      text-zinc-400 hover:text-zinc-100 hover:bg-white/[0.05] transition-colors">
              <svg class="w-4 h-4" viewBox="0 0 24 24" fill="none" stroke="currentColor"
                   stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
                <path d="M15 3h4a2 2 0 0 1 2 2v14a2 2 0 0 1-2 2h-4"/>
                <polyline points="10 17 15 12 10 7"/>
                <line x1="15" y1="12" x2="3" y2="12"/>
              </svg>
              Sign In
            </a>

            <a href="/user/signup"
               class="flex items-center gap-3 px-4 py-3 rounded-xl text-sm font-medium
                      text-violet-400 hover:text-violet-300 hover:bg-violet-500/10 transition-colors">
              Sign Up
            </a>

          <% } %>
        </div>
      </div>
    </header>

    <main>

    <script>
      let dropdownOpen = false;
      let mobileOpen = false;

      function toggleDropdown() {
        dropdownOpen = !dropdownOpen;
        const menu = document.getElementById("dropdownMenu");
        const chevron = document.getElementById("chevronIcon");
        const btn = document.getElementById("dropdownBtn");
        menu.classList.toggle("open", dropdownOpen);
        chevron.classList.toggle("open", dropdownOpen);
        btn.setAttribute("aria-expanded", dropdownOpen);
      }

      function toggleMobile() {
        mobileOpen = !mobileOpen;
        const drawer = document.getElementById("mobileDrawer");
        const btn = document.getElementById("hamburger");
        drawer.classList.toggle("open", mobileOpen);
        btn.setAttribute("aria-expanded", mobileOpen);
        document.getElementById("bar3").style.width = mobileOpen ? "20px" : "14px";
      }

      document.addEventListener("click", (e) => {
        const dd = document.getElementById("userDropdown");
        if (dd && dropdownOpen && !dd.contains(e.target)) {
          dropdownOpen = false;
          document.getElementById("dropdownMenu").classList.remove("open");
          document.getElementById("chevronIcon").classList.remove("open");
          document.getElementById("dropdownBtn").setAttribute("aria-expanded", "false");
        }
      });
    </script>
  </body>
</html>