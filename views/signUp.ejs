<!DOCTYPE html>
<html lang="en" class="h-full">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>P-Blogs — Create Account</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link
      href="https://fonts.googleapis.com/css2?family=Syne:wght@700;800&family=Outfit:wght@400;500;600&display=swap"
      rel="stylesheet"
    />
    <script>
      tailwind.config = {
        theme: {
          extend: {
            colors: {
              page: "#0B0B0F",
              surface: "#12121A",
              card: "#16161F",
            },
            fontFamily: {
              display: ["Syne", "sans-serif"],
              body: ["Outfit", "sans-serif"],
            },
          },
        },
      };
    </script>
    <style>
      body {
        font-family: "Outfit", sans-serif;
      }

      .glow-bg {
        position: fixed;
        inset: 0;
        pointer-events: none;
        background:
          radial-gradient(
            ellipse 60% 40% at 50% 0%,
            rgba(124, 58, 237, 0.13) 0%,
            transparent 70%
          ),
          radial-gradient(
            ellipse 40% 30% at 20% 100%,
            rgba(168, 85, 247, 0.07) 0%,
            transparent 60%
          );
      }

      .card-line {
        height: 1px;
        background: linear-gradient(
          90deg,
          transparent,
          #7c3aed 30%,
          #a855f7 70%,
          transparent
        );
      }

      .cursor-blink {
        display: inline-block;
        width: 2px;
        height: 15px;
        background: #a855f7;
        margin-left: 2px;
        vertical-align: middle;
        border-radius: 1px;
        animation: blink 1.1s step-start infinite;
      }
      @keyframes blink {
        0%,
        100% {
          opacity: 1;
        }
        50% {
          opacity: 0;
        }
      }

      input:focus {
        box-shadow: 0 0 0 2px rgba(124, 58, 237, 0.45);
      }

      .btn-submit {
        position: relative;
        overflow: hidden;
      }
      .btn-submit::after {
        content: "";
        position: absolute;
        inset: 0;
        background: linear-gradient(
          105deg,
          transparent 40%,
          rgba(255, 255, 255, 0.12) 50%,
          transparent 60%
        );
        transform: translateX(-100%);
        transition: transform 0.45s ease;
      }
      .btn-submit:hover::after {
        transform: translateX(100%);
      }

      /* Password strength bar */
      .strength-bar {
        height: 3px;
        border-radius: 99px;
        background: rgba(255, 255, 255, 0.06);
        overflow: hidden;
        margin-top: 8px;
      }
      .strength-fill {
        height: 100%;
        border-radius: 99px;
        width: 0%;
        transition:
          width 0.3s ease,
          background 0.3s ease;
      }
    </style>
  </head>

  <body class="h-full bg-page">
    <div class="glow-bg" aria-hidden="true"></div>

    <div
      class="relative flex min-h-full flex-col justify-center px-6 py-12 lg:px-8"
    >
      <!-- Logo -->
      <div class="sm:mx-auto sm:w-full sm:max-w-md">
        <a
          href="/"
          class="flex items-center justify-center gap-2.5 group w-fit mx-auto"
        >
          <div
            class="w-8 h-8 rounded-lg bg-violet-600 group-hover:bg-violet-500 transition-colors duration-200 flex items-center justify-center shrink-0"
          >
            <span class="font-display text-white font-bold text-sm leading-none"
              >P</span
            >
          </div>
          <span
            class="font-display font-bold text-lg text-zinc-100 tracking-tight leading-none"
          >
            P<span class="text-violet-400">-</span>Blogs
          </span>
          <span class="cursor-blink" aria-hidden="true"></span>
        </a>

        <h2
          class="mt-4 text-center text-2xl font-display font-bold tracking-tight text-zinc-100"
        >
          Create your account
        </h2>
        <p class="mt-1.5 text-center text-sm text-zinc-500">
          Start writing and sharing your ideas today
        </p>
      </div>

      <!-- Card -->
      <div class="mt-6 sm:mx-auto sm:w-full sm:max-w-md">
        <div
          class="bg-card rounded-2xl border border-white/[0.07] overflow-hidden shadow-[0_24px_64px_rgba(0,0,0,0.5)]"
        >
          <div class="card-line"></div>

          <div class="px-6 py-8">
            <form action="/user/signup" method="POST" class="space-y-5" id="signupForm">
              

              <!-- fullName -->
              <div>
                <label
                  for="fullName"
                  class="block text-sm font-medium text-zinc-300 mb-1.5"
                >
                  fullName
                </label>
                <div class="relative">
                  <span
                    class="absolute left-4 top-1/2 -translate-y-1/2 text-zinc-600 text-sm font-medium pointer-events-none select-none"
                    >@</span
                  >
                  <input
                    id="username"
                    type="text"
                    name="fullName"
                    required
                    autocomplete="fullName"
                    placeholder="johndoe"
                    class="block w-full rounded-xl bg-white/[0.04] border border-white/[0.08] pl-8 pr-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-600 hover:border-white/[0.14] focus:border-violet-500/60 focus:outline-none transition-colors duration-150"
                  />
                </div>
              </div>

              <!-- Email -->
              <div>
                <label
                  for="email"
                  class="block text-sm font-medium text-zinc-300 mb-1.5"
                >
                  Email address
                </label>
                <input
                  id="email"
                  type="email"
                  name="email"
                  required
                  autocomplete="email"
                  placeholder="you@example.com"
                  class="block w-full rounded-xl bg-white/[0.04] border border-white/[0.08] px-4 py-2.5 text-sm text-zinc-100 placeholder:text-zinc-600 hover:border-white/[0.14] focus:border-violet-500/60 focus:outline-none transition-colors duration-150"
                />
              </div>

              <!-- Password + strength meter -->
              <div>
                <label
                  for="password"
                  class="block text-sm font-medium text-zinc-300 mb-1.5"
                >
                  Password
                </label>
                <div class="relative">
                  <input
                    id="password"
                    type="password"
                    name="password"
                    required
                    autocomplete="new-password"
                    placeholder="Min. 8 characters"
                    oninput="checkStrength(this.value)"
                    class="block w-full rounded-xl bg-white/[0.04] border border-white/[0.08] px-4 py-2.5 pr-11 text-sm text-zinc-100 placeholder:text-zinc-600 hover:border-white/[0.14] focus:border-violet-500/60 focus:outline-none transition-colors duration-150"
                  />
                  <!-- Show/hide toggle -->
                  <button
                    type="button"
                    onclick="togglePwd('password', 'eyeIcon1')"
                    class="absolute right-3.5 top-1/2 -translate-y-1/2 text-zinc-600 hover:text-zinc-400 transition-colors"
                    aria-label="Toggle password"
                  >
                    <svg
                      id="eyeIcon1"
                      class="w-4 h-4"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="1.8"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                    >
                      <path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z" />
                      <circle cx="12" cy="12" r="3" />
                    </svg>
                  </button>
                </div>
        
                <!-- Submit -->
              <div class="pt-8">
                <button
                  type="submit"
                  class="btn-submit w-full flex justify-center items-center gap-2 rounded-xl bg-violet-600 hover:bg-violet-500 px-4 py-2.5 text-sm font-semibold text-white shadow-[0_0_20px_rgba(124,58,237,0.4)] hover:shadow-[0_0_28px_rgba(124,58,237,0.6)] focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet-500 transition-all duration-200"
                >
                  Create account
                  <svg
                    class="w-4 h-4 shrink-0"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.2"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M5 12h14M12 5l7 7-7 7" />
                  </svg>
                </button>
              </div>
            </form>

            <!-- Divider -->
            <div class="relative my-6">
              <div
                class="absolute inset-0 flex items-center"
                aria-hidden="true"
              >
                <div class="w-full border-t border-white/[0.06]"></div>
              </div>
              <div class="relative flex justify-center">
                <span class="bg-card px-3 text-xs text-zinc-600"
                  >already have an account?</span
                >
              </div>
            </div>

            <a
              href="/user/signin"
              class="flex w-full justify-center items-center gap-2 rounded-xl border border-white/[0.08] hover:border-violet-500/40 bg-white/[0.02] hover:bg-violet-500/[0.06] px-4 py-2.5 text-sm font-semibold text-zinc-300 hover:text-zinc-100 transition-all duration-200"
            >
              Sign in instead
            </a>
          </div>
        </div>

        <!-- Back to home -->
        <p class="mb-4 text-center">
          <a
            href="/"
            class="inline-flex items-center gap-1.5 text-xs text-zinc-600 hover:text-zinc-400 transition-colors duration-150"
          >
            <svg
              class="w-3 h-3"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M19 12H5M12 5l-7 7 7 7" />
            </svg>
            Back to P-Blogs
          </a>
        </p>
      </div>
    </div>

    <script>
      /* ── Password show/hide ── */
      function togglePwd(inputId, iconId) {
        const input = document.getElementById(inputId);
        const icon = document.getElementById(iconId);
        const isHidden = input.type === "password";
        input.type = isHidden ? "text" : "password";
        icon.innerHTML = isHidden
          ? `<path d="M17.94 17.94A10.07 10.07 0 0 1 12 20c-7 0-11-8-11-8a18.45 18.45 0 0 1 5.06-5.94"/>
           <path d="M9.9 4.24A9.12 9.12 0 0 1 12 4c7 0 11 8 11 8a18.5 18.5 0 0 1-2.16 3.19"/>
           <line x1="1" y1="1" x2="23" y2="23"/>`
          : `<path d="M2 12s3-7 10-7 10 7 10 7-3 7-10 7-10-7-10-7Z"/>
           <circle cx="12" cy="12" r="3"/>`;
      }

      /* ── Password strength ── */
      function checkStrength(val) {
        const fill = document.getElementById("strengthFill");
        const label = document.getElementById("strengthLabel");
        let score = 0;
        if (val.length >= 8) score++;
        if (/[A-Z]/.test(val)) score++;
        if (/[0-9]/.test(val)) score++;
        if (/[^A-Za-z0-9]/.test(val)) score++;

        const levels = [
          { pct: "0%", color: "", text: "" },
          { pct: "25%", color: "#ef4444", text: "Weak" },
          { pct: "50%", color: "#f97316", text: "Fair" },
          { pct: "75%", color: "#eab308", text: "Good" },
          { pct: "100%", color: "#22c55e", text: "Strong" },
        ];

        const lvl = val.length === 0 ? levels[0] : levels[score] || levels[1];
        fill.style.width = lvl.pct;
        fill.style.background = lvl.color;
        label.textContent = lvl.text;
        label.style.color = lvl.color;

        checkMatch();
      }
    </script>
  </body>
</html>
